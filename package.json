{
  "name": "whoop-mg-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Independent personal analytics platform for WHOOP 5.0 MG",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @whoop/web",
