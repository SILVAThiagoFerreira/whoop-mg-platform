{
  "name": "whoop-coach-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Desktop companion for the local Whoop Coach system",
  "author": "Thiago Ferreira",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.whoopcoach.desktop",
    "productName": "Whoop Coach",
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**"
    ],
    "extraResources": [
      {
        "from": "../local-agent",
        "to": "local-agent"
      },
      {
        "from": "../../packages/database",
        "to": "packages/database"
      },
      {
        "from": "../../models",
        "to": "models"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "protocols": [
      {
        "name": "Whoop Coach Connection",
        "schemes": [
          "whoopcoach"
        ]
      }
    ]
  }
}
